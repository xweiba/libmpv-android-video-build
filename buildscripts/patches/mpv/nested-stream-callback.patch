+// Unhook a callback stream's cancel from its parent without closing it. For
+// streams the owner deliberately leaks: the parent may be destroyed first.
+void stream_cb_detach_cancel(struct stream *stream)
+{
+    if (!stream || stream->info != &stream_info_cb)
+        return;
+    struct priv *p = stream->priv;
+    if (p && p->cancel)
+        mp_cancel_set_parent(p->cancel, NULL);
+}
